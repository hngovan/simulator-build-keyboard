{
  "name": "simulator-build-keyboard",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "dev": "vite",
    "server": "bun server/leaderboard.ts",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "convert:stab": "node scripts/convert-stab.mjs",
    "convert:switch": "node scripts/convert-switch.mjs",
    "convert:cases": "node scripts/convert-cases.mjs",
    "convert:user-cases": "node scripts/convert-user-cases.mjs",
    "convert:screws": "node scripts/convert-screws.mjs",
    "convert:spring-containers": "node scripts/convert-spring-containers.mjs",
    "convert:keycaps": "node scripts/convert-keycaps.mjs",
    "convert:plates": "node scripts/convert-plates.mjs",
    "gen:plates-universal": "bun scripts/gen-universal-plates.ts",
    "gen:plate-blossom": "bun scripts/gen-blossom-plate.ts",
    "convert:screwdriver-lite": "node scripts/convert-screwdriver-lite.mjs",
    "fetch:emotes": "node scripts/fetch-emotes.mjs",
    "fetch:avatars": "node scripts/fetch-avatars.mjs",
    "convert:solder-tools": "node scripts/convert-solder-tools.mjs",
    "convert:hand-tools": "node scripts/convert-hand-tools.mjs",
    "convert:desk-gear": "bunx @gltf-transform/cli@4.1.1 optimize assets/user-desk/topre_realforce_87u.glb public/models/desk/realforce-87u.glb --compress meshopt --texture-compress false --simplify-ratio 0.02 --simplify-error 0.0005 && bunx @gltf-transform/cli@4.1.1 optimize assets/user-desk/mouse_-_razer_deathadder.glb public/models/desk/deathadder.glb --compress meshopt --texture-compress false",
    "fetch:room": "node scripts/fetch-room.mjs",
    "convert:desolder-pump": "node scripts/convert-desolder-pump.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "lucide-react": "^1.61.0",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.1.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dxf-parser": "^1.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jpeg-js": "^0.4.4",
    "meshoptimizer": "^0.18.1",
    "occt-import-js": "^0.0.23",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.7"
  }
}
