# Biến môi trường mẫu. Chép thành .env.local nếu cần (file .env* thật không commit).
# Trên Vercel: đặt ở Settings → Environment Variables (Vercel không đọc file .env trong repo), xong phải Redeploy.

# --- Bảng xếp hạng (api/leaderboard.ts, Vercel Function) ---
# Nối Upstash Redis ở tab Storage thì Vercel tự thêm 2 biến này (tick môi trường Production).
# Tạo database tay ở console.upstash.com thì dùng tên UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN cũng được.
# Dùng token chính, không dùng token read-only.
KV_REST_API_URL=https://xxx.upstash.io
KV_REST_API_TOKEN=

# --- Server bảng xếp hạng local (bun run server) ---
# LEADERBOARD_PORT=8787
# LEADERBOARD_FILE=server/data/leaderboard.json

# --- Client ---
# Địa chỉ API khi server bảng xếp hạng nằm ở domain khác (mặc định /api cùng domain)
# VITE_LEADERBOARD_URL=https://example.com/api
